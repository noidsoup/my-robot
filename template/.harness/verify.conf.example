# .harness/verify.conf — declarative shippable-check phases (one per line).
# Format:  Label :: shell command
# Blank lines and # comments are ignored.
#
# Wire the commands that prove THIS repo is shippable. Prefer fast local checks.
# Your .verify.sh (or CI) can call:  bash scripts/run-verify-phases.sh
#
# Examples (uncomment and edit):
# smoke      :: bash .verify.sh
# lint       :: npm run lint
# typecheck  :: npm run typecheck
# test       :: npm test
# wiki-lint  :: python3 scripts/wiki-lint.py
# secret-scan :: bash scripts/secret-scan.sh

wiki-lint :: python3 scripts/wiki-lint.py
